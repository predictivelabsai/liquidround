# Runtime
ENVIRONMENT=development
PORT=5007
PUBLIC_BASE_URL=http://localhost:5007
ALLOWED_ORIGINS=http://localhost:5007
SESSION_SECRET=replace-with-at-least-32-random-characters
BACKGROUND_JOBS_ENABLED=false

# LLM and research providers
MODEL_PROVIDER=xai
DEFAULT_MODEL=grok-4-1-fast-reasoning
DEFAULT_TEMPERATURE=0.7
AGENT_TIMEOUT_SECONDS=120
AGENT_RECURSION_LIMIT=24
AGENT_MAX_TOOL_CALLS=12
XAI_API_KEY=
OPENAI_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=

# Data and authentication
DB_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=kaljuvee@gmail.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@liquidround.com
TO_EMAIL=

# Optional Hermes LangGraph delegation
HERMES_ENABLED=false
HERMES_COMMAND=hermes
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_TOOLSETS=
HERMES_TIMEOUT_SECONDS=90
HERMES_SAFE_MODE=true

# Limits and scheduled jobs
UPLOAD_MAX_BYTES=26214400
DIGEST_FREQUENCY=off
DIGEST_HOUR_UTC=7
DIGEST_WEEKDAY=1

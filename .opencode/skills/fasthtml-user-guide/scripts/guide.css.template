/* FastClinic user-guide — landscape slide deck (pandoc HTML -> WeasyPrint PDF).
   Each markdown "---" becomes a slide (page break). Brand: blue #1e6fb8,
   dark #1b2733, green #1f9d72. */

@page {
  size: A4 landscape;
  margin: 1.1cm 1.5cm 1.3cm 1.5cm;
  @bottom-left  { content: "FastClinic · Modern primary care, made personal"; font-size: 8pt; color: #9aa6b2; }
  @bottom-right { content: "v0.1.0 · 2026-07-20 · fastclinic.example"; font-size: 8pt; color: #9aa6b2; }
}

html { font-size: 11.5pt; }
body {
  font-family: "Helvetica Neue", Helvetica, Arial, "DejaVu Sans", sans-serif;
  color: #1b2733;
  line-height: 1.5;
  margin: 0;
}

/* every horizontal rule ends a slide */
hr {
  page-break-after: always;
  border: 0; height: 0; margin: 0; visibility: hidden;
}

/* ---- title slide (first H1) ---- */
h1 {
  color: #1e6fb8;
  font-size: 30pt;
  margin: 1.4cm 0 0.2cm;
  letter-spacing: .3px;
}
h1 + h2 { /* subtitle on the title slide — plain, not a slide bar */
  background: none; border: 0; border-left: 0; border-radius: 0; padding: 0;
  color: #55636f; font-size: 17pt; font-weight: 600; margin: .1cm 0 .6cm;
}

/* ---- cover page (pandoc `::: cover` fenced div) ---- */
.cover { text-align: center; padding-top: 4cm; }
.cover h1 { color: #1e6fb8; font-size: 42pt; margin: 0 0 .35cm; letter-spacing: .5px; }
.cover h2, .cover h3, .cover h4 {
  background: none; border: 0; padding: 0; border-radius: 0;
  color: #55636f; font-weight: 600; font-size: 18pt; margin: .25cm 0;
}
.cover p { font-size: 14pt; color: #3a4855; margin: .4cm 0; }
.cover strong { color: #17568f; }
.cover em { color: #6b7278; }

/* ---- slide titles ---- */
h2 {
  color: #ffffff;
  background: #1e6fb8;
  font-size: 17pt;
  margin: 0 0 .55cm;
  padding: .28cm .5cm;
  border-radius: 7px;
  border-left: 7px solid #1f9d72;
}
h3 {
  color: #1e6fb8;
  font-size: 13pt;
  margin: .35cm 0 .15cm;
}

p { margin: .18cm 0; }
strong { color: #17568f; }

ul, ol { margin: .15cm 0 .2cm; padding-left: .85cm; }
li { margin: .12cm 0; }

a { color: #1e6fb8; text-decoration: none; }
code {
  background: #eef4fa; color: #17568f;
  padding: .04cm .14cm; border-radius: 3px;
  font-family: "DejaVu Sans Mono", monospace; font-size: .88em;
}

blockquote {
  margin: .35cm 0; padding: .25cm .55cm;
  background: #eef4fa; border-left: 4px solid #1e6fb8;
  color: #3a4855; font-style: italic;
}

/* screenshots — sit on the right of a slide, capped so the slide fits one page */
img {
  display: block;
  float: right;
  max-width: 14cm;
  max-height: 13.6cm;
  margin: 0 0 .3cm .7cm;
  border: 1px solid #d5e2ef;
  border-radius: 6px;
}

/* reference tables (Appendix) */
table { border-collapse: collapse; width: 100%; font-size: 8.4pt; margin: .2cm 0; }
th {
  background: #1e6fb8; color: #fff; text-align: left; font-weight: 600;
  padding: 3px 7px; border: 1px solid #17568f;
}
td { padding: 2.5px 7px; border: 1px solid #d5e2ef; vertical-align: top; }
tr:nth-child(even) td { background: #eef4fa; }
table code { font-size: 7.8pt; background: none; color: #17568f; padding: 0; }

/* keep a slide's content together on its page */
h2, h3, p, ul, ol, blockquote, img { page-break-inside: avoid; }
table { page-break-inside: auto; }
tr { page-break-inside: avoid; }
